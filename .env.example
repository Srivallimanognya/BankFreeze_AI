# BankFreeze AI - Configuration Template
# DEMONSTRATION & PROTOTYPE MODE ONLY
# Do NOT use real banking or confidential government credentials.

# Application
APP_NAME=BankFreeze AI
APP_ENV=development
SECRET_KEY=demo-secret-key-change-in-production-bankfreeze-2025
DATABASE_URL=sqlite:///bankfreeze.db

# LLM Configuration (Optional - OpenAI compatible)
# Leave blank to use built-in deterministic offline heuristic analysis engine
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Mock Adapter Configuration
MOCK_BANK_LATENCY_SECONDS=0.3
MOCK_AUTHORITY_LATENCY_SECONDS=0.4
DEMO_MODE=True

# Security Guardrails
MASK_ACCOUNT_NUMBERS=True
ENFORCE_STRICT_SAFEGUARDS=True

# n8n Workflow Integration (DEMO / PROTOTYPE)
# Paste your n8n webhook URL here to enable live workflow triggering from the UI.
# Example: https://your-n8n-instance.example.com/webhook/your-unique-id
# Leave blank to run in offline demo mode (fully functional without n8n).
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL
N8N_TIMEOUT_SECONDS=30
